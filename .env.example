# -------------------------
# Runner settings
# -------------------------
X402BENCH_ENV=hackathon
X402BENCH_LOG_LEVEL=info

# -------------------------
# Hedera SDK mode (optional)
# If HEDERA_MODE=sdk, install @hashgraph/sdk and set:
# -------------------------
HEDERA_MODE=relay
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=

# -------------------------
# Hedera relay mode
# -------------------------
HEDERA_RELAY_URL=
HEDERA_RELAY_API_KEY=

# -------------------------
# Chainlink CRE mode
# mode=cli (requires cre CLI) or webhook
# -------------------------
CHAINLINK_MODE=webhook
CHAINLINK_CLI_PATH=cre
CHAINLINK_WEBHOOK_URL=
CHAINLINK_WEBHOOK_TOKEN=

# -------------------------
# Ledger integration mode
# mode=external_approver or ledger_hw
# -------------------------
LEDGER_MODE=external_approver
LEDGER_APPROVER_URL=
LEDGER_APPROVER_TOKEN=

# -------------------------
# x402-protected service endpoint
# -------------------------
SERVICE_PROBE_URL=
SERVICE_PROBE_TOKEN=
