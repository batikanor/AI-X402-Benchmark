# -------------------------
# Runner settings
# -------------------------
X402BENCH_ENV=hackathon
X402BENCH_LOG_LEVEL=info

# -------------------------
# Hedera SDK mode (optional)
# If HEDERA_MODE=sdk, install @hashgraph/sdk and set:
# -------------------------
HEDERA_MODE=relay
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=

# -------------------------
# Hedera relay mode
# -------------------------
HEDERA_RELAY_URL=
HEDERA_RELAY_API_KEY=

# -------------------------
# Chainlink CRE mode
# mode=cli (requires cre CLI) or webhook
# -------------------------
CHAINLINK_MODE=webhook
CHAINLINK_CLI_PATH=cre
CHAINLINK_CRE_ACTION=simulate
# Optional arg template. Tokens: ${runId}, ${scenarioId}, ${jsonPayload}
# Example:
# CHAINLINK_CLI_ARGS=workflow,simulate,--input,${jsonPayload}
CHAINLINK_WEBHOOK_URL=
CHAINLINK_WEBHOOK_TOKEN=

# -------------------------
# Ledger integration mode
# mode=external_approver or ledger_hw
# -------------------------
LEDGER_MODE=external_approver
LEDGER_APPROVER_URL=
LEDGER_APPROVER_TOKEN=

# -------------------------
# x402-protected service endpoint
# -------------------------
SERVICE_PROBE_URL=
SERVICE_PROBE_TOKEN=

# -------------------------
# Optional Hedera settlement throttling (reduce testnet token burn)
# -------------------------
# Exact HBAR per settlement transfer (highest priority if set)
X402BENCH_SETTLEMENT_HBAR_OVERRIDE=
# Multiplies scenario amountHbar when override is empty
X402BENCH_SETTLEMENT_HBAR_MULTIPLIER=1
# Safety bounds applied to effective settlement amount
X402BENCH_SETTLEMENT_HBAR_MIN=0.0001
X402BENCH_SETTLEMENT_HBAR_MAX=

# -------------------------
# Optional OpenAI-compatible runtime credentials (for readiness benchmark)
# -------------------------
OPENAI_API_KEY=
# Official OpenAI Chat Completions base URL
OPENAI_BASE_URL=https://api.openai.com/v1
# OpenRouter key/base URL (recommended default for fast hosted OSS runs)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=https://x402bench.local
OPENROUTER_TITLE=x402Bench
# Per-model API request timeout in ms (prevents stalled provider calls from hanging a run)
X402BENCH_MODEL_TIMEOUT_MS=90000
# Hugging Face router token (only needed for readiness:bench:hf)
HF_TOKEN=

# Recommended cheap OpenAI models (as of April 2026):
# gpt-5.4-mini
# gpt-5.4-nano
